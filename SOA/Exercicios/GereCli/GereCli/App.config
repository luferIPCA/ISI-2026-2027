<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="GereDataSoap" />
                <binding name="BasicHttpBinding_ICountry">
                    <security mode="Transport" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:58103/GereData.asmx" binding="basicHttpBinding"
                bindingConfiguration="GereDataSoap" contract="WS.GereDataSoap"
                name="GereDataSoap" />
            <endpoint address="https://localhost:7095/Country.svc" binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_ICountry" contract="WS2.ICountry"
                name="BasicHttpBinding_ICountry" />
        </client>
    </system.serviceModel>
</configuration>